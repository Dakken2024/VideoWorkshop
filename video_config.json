{
  "wechat_channels": {
    "resolution": [1080, 1920],
    "fps": 30,
    "codec": "libx264",
    "preset": "slow",
    "crf": 23,
    "profile": "high",
    "level": "4.1",
    "pixel_format": "yuv420p",
    "audio_codec": "aac",
    "audio_bitrate": "128k",
    "faststart": true,
    "max_file_size_mb": 100,
    "target_bitrate_range": [3000, 5000]
  },
  "quality_presets": {
    "high": {
      "crf": 20,
      "preset": "slow",
      "audio_bitrate": "192k",
      "description": "高质量 - 文件较大，画质最佳",
      "use_case": "重要内容、品牌宣传"
    },
    "balanced": {
      "crf": 23,
      "preset": "medium",
      "audio_bitrate": "128k",
      "description": "平衡模式 - 推荐用于微信视频号",
      "use_case": "日常内容、科普视频"
    },
    "small": {
      "crf": 26,
      "preset": "fast",
      "audio_bitrate": "96k",
      "description": "小文件 - 适合长视频",
      "use_case": "长视频、教程内容"
    }
  },
  "encoding_options": {
    "use_gpu": false,
    "gpu_codec": "h264_nvenc",
    "threads": 0,
    "two_pass": false,
    "tune": "fastdecode"
  },
  "validation": {
    "check_bitrate": true,
    "check_resolution": true,
    "check_codec": true,
    "check_file_size": true,
    "max_warnings": 5
  },
  "output": {
    "add_watermark": true,
    "watermark_text": "Saabor AI Builds",
    "generate_report": true,
    "report_format": "json"
  }
}
