# Video Workshop Configuration
# 复制此文件为 .env 并填写你的 API Key

# === AI 大模型 (DeepSeek) ===
# DeepSeek API Key: https://platform.deepseek.com/
AI_API_KEY=sk-your-deepseek-api-key-here
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-v4-flash

# === 搜索服务 ===
# SerpAPI Key: https://serpapi.com/
SERPAPI_KEY=
# Tavily Key: https://tavily.com/
TAVILY_KEY=

# === 语音合成 (可选) ===
# 默认使用 edge-tts (免费)，如需自定义 API 请填写
VOICE_BASE_URL=
VOICE_API_KEY=